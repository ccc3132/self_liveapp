<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace 는 DAO 의 빈 이름과 같게 한다 (systemCheckDAO) -->
<mapper namespace="systemCheckDAO">

    <select id="selectSystemCheck" resultType="egovframework.egovwebpractice.common.service.SystemCheckVO">
        SELECT id, message
          FROM system_check
         ORDER BY id
         LIMIT 1
    </select>
</mapper>
