# docker-compose.yml 이 쓰는 값. 복사해서 .env 로 저장하고 값을 채우세요: cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않습니다.

# PostgreSQL 비밀번호 (직접 정해서 적으세요)
DB_PASSWORD=change-me

# JWT 서명 키 (모바일 앱 로그인용). 32자 이상 무작위 문자열을 권장합니다.
# 예: openssl rand -base64 32
APP_JWT_SECRET=change-me-too

# 앞에 HTTPS 리버스 프록시가 있으면 true, 평문 HTTP 로 바로 접속한다면 false
COOKIE_SECURE=false

# 호스트에서 접속할 포트 (기본 8080)
APP_PORT=8080
